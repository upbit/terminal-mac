# Read from .env in the process working directory. Environment variables override it.
# Use TERMINAL_MAC_ENV_FILE=/absolute/path/.env when the MCP client has another cwd.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_SAMPLE_RATE=1
# summary preserves existing redaction; content records sanitized text/JSON (no images).
LANGFUSE_CONTENT_MODE=summary
# Screenshot upload is independent and off by default (max 2 MiB per image).
# LANGFUSE_MEDIA_ENABLED=true
# Exact presigned storage hostnames only; no wildcard. Project API keys are never sent there.
# LANGFUSE_MEDIA_UPLOAD_HOSTS=media.example.com
# Only for trusted internal HTTP deployments; sends keys without TLS:
# LANGFUSE_ALLOW_INSECURE_HTTP=true
# Optional kill switch: LANGFUSE_TRACING_ENABLED=false
# Optional opaque identifiers (do not use names, emails, paths, or credentials):
# LANGFUSE_SESSION_ID=
# LANGFUSE_USER_ID=
